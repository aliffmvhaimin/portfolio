---
interface Props {
  title: string;
  category: string;
  description: string;
  image: string;
  imageAlt: string;
  tags: string[];
  githubUrl?: string;
  liveUrl?: string;
}

const {
  title,
  category,
  description,
  image,
  imageAlt,
  tags,
  githubUrl,
  liveUrl,
} = Astro.props;
---

<article class="group relative flex flex-col overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900/40 transition-colors duration-300 hover:border-zinc-700 hover:bg-zinc-900/70">
  <!-- Visual Preview Container (16:9 Aspect Ratio) -->
  <div class="relative aspect-video w-full overflow-hidden bg-zinc-950 border-b border-zinc-800">
    <img
      src={image}
      alt={imageAlt}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
    />
    <!-- Subtle dark gradient overlay to blend image into the card body -->
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/60 via-transparent to-transparent opacity-60"></div>
    
    <!-- Category Badge -->
    <span class="absolute top-3 left-3 rounded border border-zinc-700/80 bg-zinc-950/90 px-2.5 py-1 font-mono text-[11px] font-medium uppercase tracking-wider text-zinc-300 backdrop-blur-md">
      {category}
    </span>
  </div>

  <!-- Card Content -->
  <div class="flex flex-1 flex-col justify-between p-6">
    <div>
      <h3 class="text-xl font-semibold tracking-tight text-zinc-100 group-hover:text-white">
        {title}
      </h3>
      
      <p class="mt-2.5 text-sm leading-relaxed text-zinc-400">
        {description}
      </p>
    </div>

    <div class="mt-6">
      <!-- Tech Stack Tags -->
      <div class="flex flex-wrap gap-1.5 pb-6 border-b border-zinc-800/80">
        {tags.map((tag) => (
          <span class="rounded bg-zinc-800/60 px-2.5 py-1 font-mono text-xs text-zinc-300 border border-zinc-700/40">
            {tag}
          </span>
        ))}
      </div>

      <!-- Action Links -->
      <div class="mt-4 flex items-center gap-5 text-sm font-medium">
        {githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-zinc-400 transition-colors hover:text-zinc-100"
            aria-label={`View source code for ${title} on GitHub`}
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>Source Code</span>
          </a>
        )}

        {liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-zinc-200 transition-colors hover:text-white ml-auto"
            aria-label={`View live demo or documentation for ${title}`}
          >
            <span>Explore Project</span>
            <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
</article>