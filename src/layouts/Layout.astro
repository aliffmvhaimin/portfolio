---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Aliff Muhaimin | Full-Stack Developer',
  description = 'Portfolio of Aliff Muhaimin, a Full-Stack Developer specialising in React, Next.js, Tailwind CSS, and Node.js.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="min-h-screen">

    <!-- ── Navigation ── -->
    <header class="sticky top-0 z-50 bg-white border-b-2 border-black">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">

        <!-- Logo monogram -->
        <a href="/" class="flex items-center gap-3 group" aria-label="Home">
          <span
            class="w-10 h-10 bg-accent border-2 border-black shadow-hard-sm font-mono font-bold text-white flex items-center justify-center text-sm
                   transition-all duration-100 group-hover:-translate-x-[1px] group-hover:-translate-y-[1px] group-hover:shadow-hard"
          >AM</span>
          <span class="font-grotesk font-bold text-lg tracking-tight hidden sm:block">Aliff Muhaimin</span>
        </a>

        <!-- Nav links -->
        <nav class="flex items-center gap-1">
          <a href="#about"    class="font-mono font-bold text-sm px-4 py-2 border-2 border-transparent hover:border-black hover:bg-accent hover:text-white transition-all duration-100">About</a>
          <a href="#projects" class="font-mono font-bold text-sm px-4 py-2 border-2 border-transparent hover:border-black hover:bg-accent hover:text-white transition-all duration-100">Projects</a>
          <a href="#contact"  class="font-mono font-bold text-sm px-4 py-2 border-2 border-transparent hover:border-black hover:bg-accent hover:text-white transition-all duration-100">Contact</a>
        </nav>

      </div>
    </header>

    <!-- ── Page Content ── -->
    <main>
      <slot />
    </main>

    <!-- ── Footer ── -->
    <footer class="border-t-2 border-black bg-black text-white py-8 mt-24">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="font-mono text-sm">© 2026 <span class="font-bold">Aliff Muhaimin</span>. Built with Astro & Tailwind CSS.</p>
        <a href="#about" class="font-mono text-sm font-bold border-2 border-white px-4 py-1.5 shadow-[3px_3px_0_0_#7C3AED] hover:-translate-y-[1px] hover:shadow-[3px_4px_0_0_#7C3AED] transition-all duration-100">↑ Back to Top</a>
      </div>
    </footer>

  </body>
</html>
